<script>
  const siteScreen = document.getElementById('gb-site-screen');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const scrollBehavior = () => reducedMotion.matches ? 'auto' as const : 'smooth' as const;
  const controls = document.querySelector('.gb-site .gb-controls');
  controls?.addEventListener('contextmenu', event => event.preventDefault());
  controls?.addEventListener('selectstart', event => event.preventDefault());
  const consoleBody = document.querySelector('.gb-site > .gb-body');
  const isScreenTouch = (event: Event) => (event.target as Element | null)?.closest('.gb-site-screen, .gb-menu-overlay');
  // iOS Safariの筐体・ボタン長押しで選択メニューを出さない。画面内の通常スクロールは残す。
  consoleBody?.addEventListener('touchstart', event => {
    if (!isScreenTouch(event)) event.preventDefault();
  }, { passive: false });
  consoleBody?.addEventListener('contextmenu', event => {
    if (!isScreenTouch(event)) event.preventDefault();
  });
  consoleBody?.addEventListener('selectstart', event => {
    if (!isScreenTouch(event)) event.preventDefault();
  });
  controls?.querySelectorAll<HTMLButtonElement>('button').forEach(button => {
    if (button.dataset.siteScroll === 'up' || button.dataset.siteScroll === 'down') return;
    let touchActivation = -Infinity;
    let touchStart: { x: number; y: number } | null = null;
    button.addEventListener('pointerdown', event => {
      if (event.pointerType === 'touch') touchStart = { x: event.clientX, y: event.clientY };
    });
    // touchstartを抑止するとSafariは通常のclickを送らないので、指を離した時に一度だけ発火させる。
    button.addEventListener('pointerup', event => {
      if (event.pointerType !== 'touch') return;
      const started = touchStart;
      touchStart = null;
      if (!started || Math.hypot(event.clientX - started.x, event.clientY - started.y) > 12) return;
      touchActivation = performance.now();
      button.click();
    });
    button.addEventListener('pointercancel', () => { touchStart = null; });
    button.addEventListener('click', event => {
      if (event.isTrusted && performance.now() - touchActivation < 700) {
        event.preventDefault();
        event.stopImmediatePropagation();
      }
    }, true);
  });
  const menu = document.getElementById('gb-menu');
  const menuItems = Array.from(menu?.querySelectorAll<HTMLButtonElement>('[data-menu-target]') ?? []);
  let menuOpen = false;
  let menuIndex = 0;
  const selectMenu = (index: number) => {
    menuIndex = (index + menuItems.length) % menuItems.length;
    menuItems.forEach((item, i) => item.classList.toggle('selected', i === menuIndex));
    menuItems[menuIndex]?.focus({ preventScroll: true });
    menuItems[menuIndex]?.scrollIntoView({ block: 'nearest', behavior: 'instant' });
  };
  const closeMenu = () => {
    if (!menuOpen) return;
    menuOpen = false;
    if (menu) menu.hidden = true;
    if (siteScreen) siteScreen.inert = false;
    document.querySelector<HTMLButtonElement>('[data-site-action="menu"]')?.focus({ preventScroll: true });
  };
  const openMenu = () => {
    if (!menu || !siteScreen || document.documentElement.dataset.displayMode !== 'gba') return;
    menuOpen = true;
    menu.hidden = false;
    siteScreen.inert = true;
    selectMenu(0);
  };
  const menuAction = (target: string) => {
    closeMenu();
    if (target === 'settings') { document.getElementById('settings-toggle')?.click(); return; }
    if (target === 'fullscreen') { document.getElementById('fullscreen-toggle')?.click(); return; }
    if (target === 'normal') { document.getElementById('display-mode-toggle')?.click(); return; }
    if (!siteScreen) return;
    if (target === 'top' || target === 'bottom') {
      siteScreen.scrollTo({ top: target === 'top' ? 0 : siteScreen.scrollHeight, behavior: 'instant' });
      return;
    }
    const section = siteScreen.querySelector<HTMLElement>(`#${target}`);
    if (section) {
      const navHeight = document.getElementById('page-nav')?.clientHeight ?? 44;
      const top = siteScreen.scrollTop + section.getBoundingClientRect().top - siteScreen.getBoundingClientRect().top - navHeight - 8;
      siteScreen.scrollTo({ top, behavior: 'instant' });
    }
  };
  menuItems.forEach((item, index) => {
    item.addEventListener('pointerenter', () => { if (menuOpen) selectMenu(index); });
    item.addEventListener('click', () => menuAction(item.dataset.menuTarget ?? 'top'));
  });
  document.querySelector('[data-site-action="menu"]')?.addEventListener('click', () => menuOpen ? closeMenu() : openMenu());
  document.addEventListener('keydown', event => {
    if (!menuOpen) return;
    if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') { event.preventDefault(); selectMenu(menuIndex - 1); }
    if (event.key === 'ArrowDown' || event.key === 'ArrowRight') { event.preventDefault(); selectMenu(menuIndex + 1); }
    if (event.key === 'Escape' || event.key.toLowerCase() === 'b') { event.preventDefault(); closeMenu(); }
    if (event.key.toLowerCase() === 'a') { event.preventDefault(); menuItems[menuIndex]?.click(); }
  });
  new MutationObserver(() => { if (document.documentElement.dataset.displayMode !== 'gba') closeMenu(); })
    .observe(document.documentElement, { attributes: true, attributeFilter: ['data-display-mode'] });
  const scrollStep = (direction: number) => siteScreen?.scrollBy({ top: direction * 4, behavior: 'instant' });
  document.querySelectorAll<HTMLButtonElement>('[data-site-scroll]').forEach(button => {
    const action = button.dataset.siteScroll;
    if (action === 'up' || action === 'down') {
      const direction = action === 'up' ? -1 : 1;
      let repeat: number | undefined;
      const stop = () => { window.clearInterval(repeat); repeat = undefined; };
      button.addEventListener('pointerdown', event => {
        if (!siteScreen || (event.pointerType === 'mouse' && event.button !== 0)) return;
        event.preventDefault();
        stop();
        button.setPointerCapture(event.pointerId);
        if (menuOpen) selectMenu(menuIndex + direction);
        else scrollStep(direction);
        repeat = window.setInterval(() => {
          if (menuOpen) selectMenu(menuIndex + direction);
          else scrollStep(direction);
        }, menuOpen ? 160 : 35);
      });
      button.addEventListener('pointerup', stop);
      button.addEventListener('pointercancel', stop);
      button.addEventListener('lostpointercapture', stop);
      button.addEventListener('click', event => {
        if (event.detail === 0) {
          if (menuOpen) selectMenu(menuIndex + direction);
          else scrollStep(direction);
        }
      });
      return;
    }
    button.addEventListener('click', () => {
      if (!siteScreen) return;
      if (menuOpen) {
        if (button.classList.contains('gbdpad-btn')) selectMenu(menuIndex + (action === 'next' ? 1 : -1));
        else if (action === 'next') menuItems[menuIndex]?.click();
        else if (action === 'prev') closeMenu();
        return;
      }
      if (action === 'home') { siteScreen.scrollTo({ top: 0, behavior: scrollBehavior() }); return; }
      if (action === 'end') { siteScreen.scrollTo({ top: siteScreen.scrollHeight, behavior: scrollBehavior() }); return; }
      if (action !== 'next' && action !== 'prev') return;
      // 横方向は主要セクションの先頭へ移動する。空のアンカーは除く。
      const navHeight = document.getElementById('page-nav')?.clientHeight ?? 44;
      const screenTop = siteScreen.getBoundingClientRect().top;
      const sectionTops = Array.from(siteScreen.querySelectorAll<HTMLElement>('.main-container > div'))
        .filter(section => section.clientHeight > 20)
        .map(section => Math.max(0, siteScreen.scrollTop + section.getBoundingClientRect().top - screenTop - navHeight - 8));
      const target = action === 'next'
        ? sectionTops.find(top => top > siteScreen.scrollTop + 12)
        : sectionTops.reverse().find(top => top < siteScreen.scrollTop - 12);
      if (target !== undefined) siteScreen.scrollTo({ top: target, behavior: scrollBehavior() });
      else if (action === 'prev') siteScreen.scrollTo({ top: 0, behavior: scrollBehavior() });
    });
  });
  const IMAGES = [
    { src: "https://picsum.photos/seed/10/800/520",  title: "Cat Sketch #1" },
    { src: "https://picsum.photos/seed/20/800/520",  title: "Fantasy Landscape" },
    { src: "https://picsum.photos/seed/30/800/520",  title: "Pixel Character" },
    { src: "https://picsum.photos/seed/40/800/520",  title: "Night City" },
    { src: "https://picsum.photos/seed/50/800/520",  title: "Portrait Study" },
    { src: "https://picsum.photos/seed/60/800/520",  title: "Abstract Flow" },
    { src: "https://picsum.photos/seed/70/800/520",  title: "Creature Design" },
    { src: "https://picsum.photos/seed/80/800/520",  title: "Neon Alley" },
    { src: "https://picsum.photos/seed/90/800/520",  title: "Chibi Character" },
    { src: "https://picsum.photos/seed/100/800/520", title: "Scenery Draft" },
  ];

  const FILTERS = [
    { key: "none", label: "NORMAL", mode: "",         pixelSize: 5  },
    { key: "crt",  label: "CRT",    mode: "mode-crt", pixelSize: 3  },
    { key: "gb",   label: "G·BOY", mode: "mode-gb",  pixelSize: 10 },
    { key: "vhs",  label: "VHS",    mode: "mode-vhs", pixelSize: 4  },
    { key: "dot",  label: "DOT",    mode: "mode-dot", pixelSize: 16 },
  ];

  // =====================================================
  // Preparing: 8bitピクセルアニメーション
  // =====================================================
  (function startPreparingAnim() {
    const pc = document.getElementById("preparing-canvas") as HTMLCanvasElement | null;
    if (!pc) return;
    const ctx = pc.getContext("2d");
    if (!ctx) return;

    const PIXEL = 8;
    const cols  = Math.floor(pc.width  / PIXEL);
    const rows  = Math.floor(pc.height / PIXEL);

    // 暗→明 のテーマカラー系パレット（8色、色相連動）
    const hue = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--theme-hue').trim()) || 225;
    const PAL = [
      `hsl(${hue},60%,3%)`,  `hsl(${hue},60%,7%)`,  `hsl(${hue},62%,14%)`,
      `hsl(${hue},65%,22%)`, `hsl(${hue},68%,32%)`,  `hsl(${hue},100%,62%)`,
      `hsl(${hue},90%,72%)`, `hsl(${hue},80%,82%)`,
    ];

    let animId: number;
    function draw() {
      const t = Date.now() / 500;
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          // 斜めの波 + ランダムなちらつき
          const wave = Math.sin(t + r * 0.45 + c * 0.35)
                     + Math.sin(t * 1.7 + r * 0.2 - c * 0.5) * 0.4;
          const norm = (wave + 1.4) / 2.8; // 0〜1
          const idx  = Math.min(Math.floor(norm * PAL.length), PAL.length - 1);
          if (!ctx) return;
          ctx.fillStyle = PAL[idx];
          ctx.fillRect(c * PIXEL, r * PIXEL, PIXEL - 1, PIXEL - 1);
        }
      }
      animId = requestAnimationFrame(draw);
    }
    draw();

    // 画像表示に切り替わったらアニメーション停止
    const observer = new MutationObserver(() => {
      const canvas = document.getElementById("viewer-canvas") as HTMLCanvasElement | null;
      if (canvas && canvas.style.display !== "none") {
        cancelAnimationFrame(animId);
        observer.disconnect();
      }
    });
    const viewerCanvas = document.getElementById("viewer-canvas");
    if (viewerCanvas) observer.observe(viewerCanvas, { attributes: true, attributeFilter: ["style"] });
  })();

  let imgIdx    = 0;
  let filterIdx = 0; // フィルターなし固定
  const dotMode = true; // ドット絵固定

  // =====================================================
  // Canvas描画: dotMode に応じてドット絵 or スムーズ切り替え
  // =====================================================
  function renderToCanvas(
    src: string,
    canvas: HTMLCanvasElement,
    pixelSize: number,
    smooth: boolean,
    onDone?: () => void
  ) {
    const img = new Image();
    img.crossOrigin = "anonymous";
    img.onload = () => {
      const cw = canvas.width;
      const ch = canvas.height;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      // object-fit: contain 相当の配置計算
      const ir = img.naturalWidth / img.naturalHeight;
      const cr = cw / ch;
      let dw: number, dh: number, dx: number, dy: number;
      if (ir > cr) {
        dw = cw; dh = Math.round(cw / ir);
      } else {
        dh = ch; dw = Math.round(ch * ir);
      }
      dx = Math.round((cw - dw) / 2);
      dy = Math.round((ch - dh) / 2);

      ctx.fillStyle = "#010108";
      ctx.fillRect(0, 0, cw, ch);

      if (smooth) {
        // ─── スムーズモード: 高品質リサンプリングで直接描画 ───
        ctx.imageSmoothingEnabled = true;
        (ctx as any).imageSmoothingQuality = "high";
        ctx.drawImage(img, dx, dy, dw, dh);
      } else {
        // ─── ドットモード: ダウンスケール→アップスケールでピクセルブロック化 ───
        const smallW = Math.max(1, Math.floor(dw / pixelSize));
        const smallH = Math.max(1, Math.floor(dh / pixelSize));

        const offscreen = document.createElement("canvas");
        offscreen.width  = smallW;
        offscreen.height = smallH;
        const offCtx = offscreen.getContext("2d");
        if (!offCtx) return;
        offCtx.imageSmoothingEnabled = false;
        offCtx.drawImage(img, 0, 0, smallW, smallH);

        ctx.imageSmoothingEnabled = false;
        ctx.drawImage(offscreen, 0, 0, smallW, smallH, dx, dy, dw, dh);
      }

      onDone?.();
    };
    img.onerror = () => {
      const ctx = canvas.getContext("2d");
      if (ctx) { ctx.fillStyle = "#111122"; ctx.fillRect(0, 0, canvas.width, canvas.height); }
    };
    img.src = src;
  }

  function getCanvas(): HTMLCanvasElement | null {
    return document.getElementById("viewer-canvas") as HTMLCanvasElement | null;
  }

  function showImage(idx: number) {
    const canvas  = getCanvas();
    const title   = document.getElementById("viewer-title");
    const counter = document.getElementById("viewer-counter");
    const hudCtr  = document.getElementById("viewer-hud-counter");
    const flash   = document.getElementById("viewer-flash");
    const dots    = document.querySelectorAll(".viewer-dot");
    if (!canvas) return;

    const d = IMAGES[idx];
    const n = String(idx + 1).padStart(2, "0");
    const t = String(IMAGES.length).padStart(2, "0");

    if (flash) { flash.classList.add("active"); setTimeout(() => flash.classList.remove("active"), 80); }

    canvas.style.opacity   = "0";
    canvas.style.transform = "scaleX(0.92)";

    setTimeout(() => {
      renderToCanvas(d.src, canvas, FILTERS[filterIdx].pixelSize, !dotMode, () => {
        canvas.style.opacity   = "1";
        canvas.style.transform = "scaleX(1)";
      });
      canvas.setAttribute("aria-label", d.title);
    }, 120);

    if (title)   title.textContent = d.title;
    if (counter) counter.textContent = `${n}/${t}`;
    if (hudCtr)  hudCtr.textContent  = `${n} / ${t}`;
    dots.forEach((dot, i) => dot.classList.toggle("active", i === idx));
    imgIdx = idx;
  }

  // ===== イベントリスナー =====
  document.getElementById("illust-prev")?.addEventListener("click", () =>
    showImage((imgIdx - 1 + IMAGES.length) % IMAGES.length));
  document.getElementById("illust-next")?.addEventListener("click", () =>
    showImage((imgIdx + 1) % IMAGES.length));

  document.querySelectorAll(".viewer-dot").forEach((dot) =>
    dot.addEventListener("click", () =>
      showImage(parseInt((dot as HTMLElement).dataset.index ?? "0", 10))));

  // ===== ライトボックスモーダル =====
  let modalOpen = false;

  function openModal(idx: number) {
    const modal   = document.getElementById("gb-modal");
    const img     = document.getElementById("gb-modal-img") as HTMLImageElement | null;
    const title   = document.getElementById("gb-modal-title");
    const counter = document.getElementById("gb-modal-counter");
    if (!modal || !img) return;

    modalOpen = true;
    imgIdx = idx;

    const d = IMAGES[idx];
    const n = String(idx + 1).padStart(2, "0");
    const t = String(IMAGES.length).padStart(2, "0");
    img.src = d.src;
    img.alt = d.title;
    if (title)   title.textContent  = d.title;
    if (counter) counter.textContent = `${n} / ${t}`;

    modal.classList.add("open");
    modal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    const modal = document.getElementById("gb-modal");
    if (!modal) return;
    modalOpen = false;
    modal.classList.remove("open");
    modal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  function modalNav(dir: 1 | -1) {
    const next = (imgIdx + dir + IMAGES.length) % IMAGES.length;
    // メインギャラリーも同期
    showImage(next);
    // モーダルの画像・カウンター更新
    const img     = document.getElementById("gb-modal-img") as HTMLImageElement | null;
    const title   = document.getElementById("gb-modal-title");
    const counter = document.getElementById("gb-modal-counter");
    if (!img) return;
    const d = IMAGES[next];
    const n = String(next + 1).padStart(2, "0");
    const t = String(IMAGES.length).padStart(2, "0");
    img.src = d.src;
    img.alt = d.title;
    if (title)   title.textContent  = d.title;
    if (counter) counter.textContent = `${n} / ${t}`;
  }

  // キャンバスクリックでモーダルを開く
  getCanvas()?.addEventListener("click", () => openModal(imgIdx));

  document.getElementById("gb-modal-close")?.addEventListener("click", closeModal);
  document.getElementById("gb-modal-backdrop")?.addEventListener("click", closeModal);
  document.getElementById("modal-prev")?.addEventListener("click", () => modalNav(-1));
  document.getElementById("modal-next")?.addEventListener("click", () => modalNav(1));

  document.addEventListener("keydown", (e) => {
    if (modalOpen) {
      if (e.key === "ArrowLeft")  modalNav(-1);
      if (e.key === "ArrowRight") modalNav(1);
      if (e.key === "Escape")     closeModal();
    } else {
      if (e.key === "ArrowLeft")  showImage((imgIdx - 1 + IMAGES.length) % IMAGES.length);
      if (e.key === "ArrowRight") showImage((imgIdx + 1) % IMAGES.length);
    }
  });

  // ===== 初期表示 =====
  const initCanvas = getCanvas();
  if (initCanvas) {
    initCanvas.classList.add("dot-mode"); // デフォルトはドットモード
    renderToCanvas(IMAGES[0].src, initCanvas, FILTERS[0].pixelSize, false);
  }
</script>
