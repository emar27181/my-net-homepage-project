---
import { NAV_CONFIG, THEME_CONFIG, THEME_PRESETS, FONT_OPTIONS, fontFaceVar } from '../config/themeConfig';
import GameBoyGallery from '../components/GameBoyGallery.astro';
import '../styles/global.css';
// 追加の日本語ドットフォント（Fusion Pixel）。選ばれたときだけ読み込むので URL だけを取る
import fusionPixel12Css from '@vp-tw/cjk-web-fonts-fusion-pixel-font/dist/12px/proportional/ja/Fusion-Pixel-12px-Proportional-Japanese.css?url';
import fusionPixel10Css from '@vp-tw/cjk-web-fonts-fusion-pixel-font/dist/10px/proportional/ja/Fusion-Pixel-10px-Proportional-Japanese.css?url';
const LAZY_FONT_CSS = { 'jp:fusion-12': fusionPixel12Css, 'jp:fusion-10': fusionPixel10Css };
const DEFAULT_HUE = THEME_CONFIG.HUE;
const DEFAULT_FONT_EN = FONT_OPTIONS.en.default;
const DEFAULT_FONT_JP = FONT_OPTIONS.jp.default;
const FONT_KINDS = ['en', 'jp'] as const;
const FONT_KIND_LABELS = { en: 'FONT EN', jp: 'FONT JP' };
const FONT_KIND_ARIA = { en: '英字フォント', jp: '日本語フォント' };
const rootStyle = `--theme-hue: ${DEFAULT_HUE}; --font-en-face: ${fontFaceVar('en', DEFAULT_FONT_EN)}; --font-jp-face: ${fontFaceVar('jp', DEFAULT_FONT_JP)}`;

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "nodoame27181（のどあめ／nodoamen）のポートフォリオ。VALORANT（ヴァロラント）のプレイ動画・戦績や統計、使用デバイス・感度設定、Web制作の活動を紹介しています。" } = Astro.props;
const pageTitle = `${title} | VALORANT・ゲームプロフィール`;
---

<!doctype html>
<html data-display-mode="normal" data-font-en={DEFAULT_FONT_EN} data-font-jp={DEFAULT_FONT_JP} data-lazy-font-css={JSON.stringify(LAZY_FONT_CSS)} lang="ja" style={rootStyle}>
  <head>
    <slot name="head" />
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/icon_omencat_transparent.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/omen-cat-apple-180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="nodoamen" />
    <meta name="theme-color" content="#0d1028" />
    <title>{pageTitle}</title>
    <meta name="author" content="nodoame27181（nodoamen）" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="nodoame27181 Portfolio" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@nodoame27181" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta
      name="google-site-verification"
      content="uyjBT9z6vOnpxn6lM6YnxbI6R4jLSDIAboC8zo1slhM"
    />
  </head>
  <body
    style="margin: 0; padding: 0; color: white; font-family: var(--font-pixel); image-rendering: pixelated;"
    class="mobile-body"
  >
    <GameBoyGallery siteMode>
    <!-- ナビゲーションバー -->
    <nav id="page-nav" slot="header">
      <a href="#" class="nav-site-title">nodoamen</a>
      <div class="nav-links">
        {NAV_CONFIG.links.map(link => (
          <a href={link.href} class="nav-link">{link.label}</a>
        ))}
      </div>
      <button id="display-mode-toggle" class="display-mode-toggle" type="button" aria-label="GBA表示に切り替える" aria-pressed="false" title="GBA表示に切り替える">
        <svg class="pixel-console" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><path d="M3 1h10v1H3zM2 2h1v12H2zm11 0h1v12h-1zM3 14h10v1H3zM4 4h8v1H4zm0 1h1v4H4zm7 0h1v4h-1zM5 8h6v1H5zM5 11h3v1H5zm2-1h1v3H7zm3 1h1v1h-1zm2 1h1v1h-1z"/></svg>
      </button>
      <button id="fullscreen-toggle" class="display-mode-toggle fullscreen-toggle" type="button" aria-label="全画面表示にする" aria-pressed="false" title="全画面表示にする" hidden>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><path d="M1 1h5v2H3v3H1zm9 0h5v5h-2V3h-3zM1 10h2v3h3v2H1zm12 0h2v5h-5v-2h3z"/></svg>
      </button>
      <button id="settings-toggle" class="settings-toggle-btn nav-link" aria-label="設定" data-default-hue={DEFAULT_HUE}>{NAV_CONFIG.settingsLabel}</button>
    <!-- 設定パネル -->
    <div id="settings-panel" class="settings-panel" aria-hidden="true">
      <div class="settings-row">
        <span class="settings-label">COLOR HUE</span>
        <input type="range" id="hue-slider" min="0" max="360" value={DEFAULT_HUE} step="1" class="hue-slider">
        <span id="hue-value-display" class="hue-value-display">{DEFAULT_HUE}</span>
      </div>
      <div class="hue-presets">
        {THEME_PRESETS.map(preset => (
          <button class="hue-preset-btn" data-hue={preset.hue} style={`--pc: hsl(${preset.hue},100%,65%)`}>{preset.label}</button>
        ))}
      </div>
      {FONT_KINDS.map(kind => (
        <div class="settings-font-group">
          <span class="settings-label">{FONT_KIND_LABELS[kind]}</span>
          <div class="font-options" role="group" aria-label={FONT_KIND_ARIA[kind]}>
            {FONT_OPTIONS[kind].options.map(opt => (
              <button type="button" class="font-option" data-font-kind={kind} data-font-id={opt.id}
                aria-pressed={String(opt.id === FONT_OPTIONS[kind].default)}
                style={`--font-option: ${fontFaceVar(kind, opt.id)}, monospace`}>{opt.label}</button>
            ))}
          </div>
        </div>
      ))}
    </div>
    </nav>

    <slot />
    </GameBoyGallery>

    <!-- ドットフォントのGoogle Fonts読み込み -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Pixelify+Sans&family=Silkscreen&family=DotGothic16&family=BIZ+UDPGothic:wght@400;700&family=VT323&display=swap"
      rel="stylesheet"
    />

    <style>
      /* 全体的なドットフォント適用 */
      * {
        font-family: var(--font-pixel-jp) !important;
        image-rendering: pixelated !important;
        text-rendering: optimizeSpeed !important;
      }

      /* 見出しも本文も日本語ピクセルフォント(--font-pixel-jp)で統一 */
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: var(--font-pixel-jp) !important;
        text-shadow: 1px 1px 0px #000000 !important;
      }

      p,
      span,
      div {
        font-family: var(--font-pixel-jp) !important;
        text-shadow: 1px 1px 0px #000000 !important;
      }

      /* ピクセル感を強調 */
      body {
        -webkit-font-smoothing: none !important;
        -moz-osx-font-smoothing: unset !important;
        font-smooth: never !important;
        font-family: var(--font-pixel-jp) !important;
      }

      /* 動画グリッドのデフォルトスタイル（デスクトップ） */
      .main-container .video-grid,
      .video-grid {
        display: grid !important;
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 20px !important;
        width: 100% !important;
      }

      /* タブレット表示 */
      @media screen and (max-width: 768px) {
        .main-container .video-grid,
        .video-grid {
          grid-template-columns: 1fr !important;
          gap: 20px !important;
        }
      }

      /* スマホ表示 */
      @media screen and (max-width: 480px) {
        .main-container .video-grid,
        .video-grid {
          grid-template-columns: 1fr !important;
          gap: 0 !important;
        }
        
        .main-container {
          padding: 0 !important;
          border-width: 0 !important;
          margin: 0 !important;
          border-radius: 0 !important;
          background: transparent !important;
          box-shadow: none !important;
        }
        
        .mobile-main {
          max-width: 100% !important;
          width: 100vw !important;
          min-height: 100vh !important;
        }
        
        /* スマホでのタイトルセクション最小化 */
        @media screen and (max-width: 480px) {
          .mobile-body {
            margin: 0 !important;
            padding: 0 !important;
            overflow-x: hidden;
          }
          
          /* 全てのpaddingとmarginを0pxに */
          .main-container {
            padding: 0px !important;
            margin: 0px !important;
            max-width: 100vw !important;
            border: none !important;
            border-radius: 0px !important;
          }
          
          /* 各セクションのpaddingとmarginを0px */
          .main-container > div {
            padding: 0px !important;
            margin: 0px !important;
            margin-bottom: 2px !important;
            border-radius: 0px !important;
          }
          
          /* My Works内部の全ての余白を0px */
          .main-container > div > div > div[style*="padding: 15px"] {
            padding: 0px !important;
            margin: 0px !important;
          }
          
          /* 全てのdivの余白を強制的に削除 */
          .main-container * {
            margin-left: 0px !important;
            margin-right: 0px !important;
            padding-left: 0px !important;
            padding-right: 0px !important;
          }
          
          .title-section {
            margin-bottom: 2px !important;
            padding: 1px !important;
          }

          .video-section {
            padding: 0px !important;
            margin: 0 !important;
            border: none !important;
            background: transparent !important;
          }
        }
      }
      /* ========== ナビゲーションバー ========== */
      #page-nav {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 9000;
        box-sizing: border-box;
        height: var(--nav-offset);
        background: var(--col-bg-mid);
        border-bottom: 1px solid var(--col-primary-a40);
        box-shadow: 0 2px 8px var(--col-bg-deep);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--safe-top) 16px 0;
        font-family: var(--font-ui) !important;
      }
      .nav-site-title {
        font-family: var(--font-ui) !important;
        font-size: var(--fs-nav);
        color: var(--col-nav-text);
        text-decoration: none;
        text-shadow: 0 0 8px var(--col-primary-a50), 1px 1px 0 #000;
        white-space: nowrap;
        margin-right: 20px;
        flex-shrink: 0;
        transition: color 0.2s, text-shadow 0.2s;
      }
      .nav-site-title:hover {
        color: var(--col-nav-text);
        text-shadow: 0 0 12px var(--col-primary), 1px 1px 0 #000;
      }
      .nav-links {
        display: flex;
        gap: 20px;
        flex: 1;
        overflow-x: auto;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
      }
      .nav-links::-webkit-scrollbar { display: none; }
      .nav-link {
        font-family: var(--font-ui) !important;
        font-size: var(--fs-nav);
        color: var(--col-nav-text);
        text-decoration: none;
        text-shadow: 0 0 6px var(--col-primary-a50), 1px 1px 0 #000;
        image-rendering: pixelated;
        transition: color 0.2s, text-shadow 0.2s;
        white-space: nowrap;
      }
      .nav-link:hover {
        color: var(--col-nav-text);
        text-shadow: 0 0 10px var(--col-primary), 1px 1px 0 #000;
      }
      .settings-toggle-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        line-height: 1;
        flex-shrink: 0;
        margin-left: 12px;
      }
      .settings-toggle-btn:focus-visible {
        outline: none;
        color: var(--col-nav-text);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      /* ========== 設定パネル ========== */
      .settings-panel {
        position: fixed;
        top: calc(var(--nav-offset) + 2px); right: 8px;
        z-index: 8999;
        background: var(--col-bg-mid);
        border: 1px solid var(--col-primary-a40);
        box-shadow: 0 4px 16px var(--col-bg-deep);
        border-radius: 6px;
        padding: 14px 16px;
        min-width: 240px;
        font-family: var(--font-pixel-jp) !important;
        font-size: var(--fs-nav);
        display: none;
      }
      .settings-panel.open { display: block; }

      .settings-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
      }
      .settings-label {
        font-family: var(--font-ui) !important;
        font-size: var(--fs-nav);
        color: var(--col-primary);
        text-shadow: 0 0 6px var(--col-primary-a50), 1px 1px 0 #000;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .hue-slider {
        flex: 1;
        height: 4px;
        cursor: pointer;
        accent-color: var(--col-primary);
      }
      .hue-value-display {
        font-family: var(--font-ui) !important;
        font-size: var(--fs-nav);
        color: var(--col-text-light);
        text-shadow: 1px 1px 0 #000;
        min-width: 28px;
        text-align: right;
      }
      .hue-presets {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
      }
      .hue-preset-btn {
        font-family: var(--font-ui) !important;
        font-size: var(--fs-nav);
        padding: 3px 8px;
        background: color-mix(in srgb, var(--pc) 10%, transparent);
        border: 1px solid color-mix(in srgb, var(--pc) 50%, transparent);
        color: var(--pc);
        border-radius: 3px;
        cursor: pointer;
        text-shadow: 1px 1px 0 #000;
        transition: background 0.15s;
        image-rendering: pixelated;
      }
      .hue-preset-btn:hover {
        background: color-mix(in srgb, var(--pc) 25%, transparent);
      }

      /* フォント切り替え: ラベルをその書体で表示し、選択中は塗りで示す（外形は変えない） */
      .settings-font-group { margin-top: 12px; }
      .settings-font-group .settings-label { display: block; margin-bottom: 6px; }
      .font-options { display: flex; flex-wrap: wrap; gap: 6px; }
      .settings-panel .font-option {
        font-family: var(--font-option) !important;
        font-size: var(--fs-nav);
        min-height: 24px;
        padding: 2px 8px;
        background: transparent;
        border: 1px solid var(--col-primary-a50);
        color: var(--col-nav-text);
        border-radius: 3px;
        cursor: pointer;
        text-shadow: 1px 1px 0 #000;
      }
      .settings-panel .font-option:hover { background: var(--col-primary-a20); }
      .settings-panel .font-option[aria-pressed="true"] { background: var(--col-primary-a50); }

      /* 通常表示: ステータスバー(safe-area)分だけ本文を下げる。ブラウザ表示では 0px */
      :global(html:not([data-display-mode="gba"])) .mobile-body {
        padding-top: var(--safe-top) !important; /* .mobile-body の padding:0 !important に勝たせる */
      }

      /* ナビ分のpadding */
      body > *:not(#page-nav):not(.settings-panel) {
        padding-top: 0;
      }

      @media (max-width: 480px) {
        .nav-links { gap: 10px; }
        .nav-link { font-size: var(--fs-nav); }
        .settings-panel { right: 4px; min-width: 200px; }
      }

      /* ナビと設定も本体のスクリーン内に配置する */
      :global(html[data-display-mode="gba"]) #page-nav {
        position: relative;
        top: 0;
        margin: 0;
        flex: 0 0 auto;
        height: 44px;
        padding: 0 12px;
        z-index: 50;
        box-sizing: border-box;
      }
      :global(html[data-display-mode="gba"]) .settings-panel {
        position: absolute;
        top: calc(100% + 4px);
        right: 8px;
        min-width: 0;
        width: min(280px, calc(100% - 16px));
        box-sizing: border-box;
      }
      :global(html[data-display-mode="gba"]) { background-color: var(--gb-body-bg); }
      :global(html[data-display-mode="gba"]) body { height: 100dvh; overflow: hidden; background-color: var(--gb-body-bg); }
      /* ゲーム機表示は文字・筐体・画面内UIを光彩やぼかしなしで描く。 */
      :global(html[data-display-mode="gba"] .gb-site),
      :global(html[data-display-mode="gba"] .gb-site *) {
        text-shadow: none !important;
        box-shadow: none !important;
        filter: none !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
      }
      :global(html[data-display-mode="gba"] .gb-site .main-container) {
        width: 100% !important;
        max-width: 100% !important;
        min-height: 0 !important;
        margin: 0 !important;
        padding: 12px !important;
        border: 0 !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        background: transparent !important;
        box-sizing: border-box;
      }
      @media (max-width: 768px) {
        :global(html[data-display-mode="gba"] .gb-site .main-container) { padding: 12px !important; }
        .nav-site-title { margin-right: 12px; font-size: var(--fs-nav); }
      }
      @media (max-width: 480px) {
        :global(html[data-display-mode="gba"] .gb-site .main-container) { padding: 8px !important; }
        .nav-site-title { display: none; }
        :global(html[data-display-mode="gba"]) #page-nav { padding: 0 8px; }
      }
      /* 本体画面の幅に応じてページ全体の表示倍率を下げる。 */
      :global(html[data-display-mode="gba"] .gb-site:not(:fullscreen):not(.fullscreen-fallback) .main-container) {
        zoom: 1;
      }
      @container (max-width: 380px) {
        :global(html[data-display-mode="gba"] .gb-site:not(:fullscreen):not(.fullscreen-fallback) .main-container) {
          zoom: 1;
        }
      }
      .display-mode-toggle {
        display: inline-flex; align-items: center; justify-content: center;
        width: 44px; height: 40px; padding: 0; margin: 0 4px;
        flex-shrink: 0; color: var(--col-nav-text); background: transparent;
        border: none; border-radius: 0; box-shadow: none; cursor: pointer;
      }
      .display-mode-toggle:hover, .display-mode-toggle[aria-pressed="true"] {
        background: transparent;
        color: var(--col-nav-text);
      }
      .display-mode-toggle:focus-visible { outline: none; color: var(--col-nav-text); }
      .display-mode-toggle:focus-visible svg { transform: scale(1.15); }
      .display-mode-toggle svg { width: var(--nav-icon-size); height: var(--nav-icon-size); }
      .display-mode-toggle[hidden] { display: none !important; }
      .pixel-console { image-rendering: pixelated; }
      :global(html[data-display-mode="gba"]) #display-mode-toggle { display: none !important; }
      :global(html[data-display-mode="gba"]) .fullscreen-toggle { display: inline-flex; }
      :global(html[data-display-mode="gba"] .gb-site:fullscreen),
      :global(html[data-display-mode="gba"] .gb-site.fullscreen-fallback) { background: var(--col-bg-deeper); }
      :global(html[data-display-mode="gba"] .gb-site.fullscreen-fallback) {
        position: fixed; inset: 0; z-index: 9999;
      }
      :global(html[data-display-mode="gba"] .main-container *) { min-width: 0; overflow-wrap: anywhere; }
      :global(html[data-display-mode="gba"] .charts-grid),
      :global(html[data-display-mode="gba"] .profile-info-grid),
      :global(html[data-display-mode="gba"] .device-settings-grid),
      :global(html[data-display-mode="gba"] .clips-grid:not(.short-mode)),
      :global(html[data-display-mode="gba"] .main-container [style*="grid-template-columns: 1fr 1fr"]) { grid-template-columns: 1fr !important; }
      :global(html[data-display-mode="gba"] .title-second-line) { display: block !important; margin-top: 10px; }
      :global(html[data-display-mode="gba"] .main-container h1) { line-height: 1.6; }
      :global(html[data-display-mode="gba"]) .nav-site-title { display: none; }
      :global(html[data-display-mode="gba"]) .nav-links { gap: 10px; }
      :global(html[data-display-mode="gba"]) .nav-link { font-size: var(--fs-nav); }
      :global(html[data-display-mode="gba"] .gb-site:not(:fullscreen):not(.fullscreen-fallback) #page-nav) {
        height: clamp(24px, 7cqw, 32px);
        padding: 0 1.5cqw;
        gap: 0.6cqw;
      }
      :global(html[data-display-mode="gba"] .gb-site:not(:fullscreen):not(.fullscreen-fallback) .nav-links) { gap: 1.5cqw; }
      :global(html[data-display-mode="gba"] .gb-site:not(:fullscreen):not(.fullscreen-fallback) .nav-link) {
        font-size: var(--fs-nav-console);
        text-shadow: none;
      }
      :global(html[data-display-mode="gba"] .gb-site:not(:fullscreen):not(.fullscreen-fallback) .display-mode-toggle) {
        width: clamp(24px, 6cqw, 30px);
        height: clamp(22px, 6cqw, 30px);
        margin: 0;
      }
      :global(html[data-display-mode="gba"] .gb-site:not(:fullscreen):not(.fullscreen-fallback) .display-mode-toggle svg) {
        width: var(--nav-console-icon-size);
        height: var(--nav-console-icon-size);
      }
      :global(html[data-display-mode="gba"] .gb-site .main-container .filter-label) { min-width: 44px; }
      :global(html[data-display-mode="gba"] .gb-site .main-container .clips-filter-btn) { padding: 3px 6px; }
      :global(html[data-display-mode="gba"] .gb-site:not(:fullscreen):not(.fullscreen-fallback) .settings-panel :is(div, span, button, label)) {
        font-size: var(--fs-settings-console) !important;
      }
    </style>

    <script>
      import { FONT_OPTIONS, FONT_STORAGE_KEYS, fontFaceVar, type FontKind } from '../config/themeConfig';
      (function () {
        const HUE_KEY         = 'theme-hue';
        const HUE_DEFAULT_KEY = 'theme-hue-config-default';
        const root            = document.documentElement;
        // 時刻周辺とブラウザーのUIも、筐体上端と同じ共通色に合わせる。
        const syncBrowserColor = () => {
          const token = root.dataset.displayMode === 'gba' ? '--gb-body-bg' : '--col-bg-mid';
          const color = getComputedStyle(root).getPropertyValue(token).trim();
          if (color) document.querySelector('meta[name="theme-color"]')?.setAttribute('content', color);
        };
        new MutationObserver(syncBrowserColor).observe(root, { attributes: true, attributeFilter: ['style', 'data-display-mode'] });
        syncBrowserColor();

        const modeToggle = document.getElementById('display-mode-toggle');
        const fullscreenToggle = document.getElementById('fullscreen-toggle') as HTMLButtonElement | null;
        const consoleFrame = document.querySelector('.gb-site') as HTMLElement | null;
        const screen = document.getElementById('gb-site-screen');
        const syncFullscreen = () => {
          const active = document.fullscreenElement === consoleFrame || !!consoleFrame?.classList.contains('fullscreen-fallback');
          fullscreenToggle?.setAttribute('aria-pressed', String(active));
          const label = active ? '全画面表示を終了' : '全画面表示にする';
          fullscreenToggle?.setAttribute('aria-label', label);
          fullscreenToggle?.setAttribute('title', label);
        };
        fullscreenToggle?.addEventListener('click', async () => {
          if (!consoleFrame) return;
          if (document.fullscreenElement === consoleFrame) await document.exitFullscreen();
          else if (consoleFrame.classList.contains('fullscreen-fallback')) consoleFrame.classList.remove('fullscreen-fallback');
          else if (consoleFrame.requestFullscreen) {
            try { await consoleFrame.requestFullscreen(); }
            catch { consoleFrame.classList.add('fullscreen-fallback'); }
          } else consoleFrame.classList.add('fullscreen-fallback');
          syncFullscreen();
        });
        document.addEventListener('fullscreenchange', syncFullscreen);
        let normalScroll = 0;
        let gbaScroll = 0;
        modeToggle?.addEventListener('click', () => {
          const enable = root.dataset.displayMode !== 'gba';
          if (enable) normalScroll = window.scrollY;
          else {
            gbaScroll = screen?.scrollTop ?? 0;
            consoleFrame?.classList.remove('fullscreen-fallback');
            if (document.fullscreenElement === consoleFrame) void document.exitFullscreen();
          }
          root.dataset.displayMode = enable ? 'gba' : 'normal';
          if (fullscreenToggle) fullscreenToggle.hidden = !enable;
          syncFullscreen();
          modeToggle.setAttribute('aria-pressed', String(enable));
          const label = enable ? '通常表示に切り替える' : 'GBA表示に切り替える';
          modeToggle.setAttribute('aria-label', label);
          modeToggle.setAttribute('title', label);
          screen?.setAttribute('tabindex', enable ? '0' : '-1');
          requestAnimationFrame(() => {
            if (enable) screen?.scrollTo({ top: gbaScroll, behavior: 'instant' });
            else window.scrollTo({ top: normalScroll, behavior: 'instant' });
            window.dispatchEvent(new Event('resize'));
            (enable ? fullscreenToggle : modeToggle)?.focus({ preventScroll: true });
          });
        });

        // <html style="--theme-hue: N"> から config デフォルト値を取得
        const configDefault = parseInt(root.style.getPropertyValue('--theme-hue')) || 225;

        // config デフォルトが変わっていたらユーザー保存値をリセット
        const storedDefault = localStorage.getItem(HUE_DEFAULT_KEY);
        if (storedDefault !== String(configDefault)) {
          localStorage.removeItem(HUE_KEY);
          localStorage.setItem(HUE_DEFAULT_KEY, String(configDefault));
        }

        function applyHue(hue: number) {
          root.style.setProperty('--theme-hue', String(hue));
          const slider = document.getElementById('hue-slider') as HTMLInputElement | null;
          const display = document.getElementById('hue-value-display');
          if (slider) slider.value = String(hue);
          if (display) display.textContent = String(hue);
        }

        // ゲーム内オプションの試し表示と確定を通常設定と同じ入口で扱う。
        document.addEventListener('portfolio:theme-hue', event => {
          const { hue, persist } = (event as CustomEvent<{ hue: number; persist: boolean }>).detail;
          if (!Number.isFinite(hue) || hue < 0 || hue > 360) return;
          applyHue(hue);
          if (persist) localStorage.setItem(HUE_KEY, String(hue));
        });

        // ユーザー保存値があれば適用、なければ config デフォルトをそのまま使用
        const saved = localStorage.getItem(HUE_KEY);
        if (saved) applyHue(Number(saved));

        // ===== フォント切り替え（通常設定・ゲーム内オプション共通の入口） =====
        const lazyFontCss: Record<string, string> = JSON.parse(root.dataset.lazyFontCss || '{}');
        const isFontKind = (kind: unknown): kind is FontKind => kind === 'en' || kind === 'jp';
        const isFontId = (kind: FontKind, id: unknown) =>
          FONT_OPTIONS[kind].options.some(opt => opt.id === id);
        // 追加フォントの @font-face は選ばれたときに初めて読み込む
        const ensureFontCss = (kind: FontKind, id: string) => {
          const href = lazyFontCss[`${kind}:${id}`];
          if (!href || document.querySelector(`link[data-lazy-font="${kind}:${id}"]`)) return;
          const link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = href;
          link.dataset.lazyFont = `${kind}:${id}`;
          document.head.appendChild(link);
        };
        function applyFont(kind: FontKind, id: string, persist = false) {
          if (!isFontId(kind, id)) return;
          ensureFontCss(kind, id);
          root.style.setProperty(`--font-${kind}-face`, fontFaceVar(kind, id));
          root.dataset[kind === 'en' ? 'fontEn' : 'fontJp'] = id;
          document.querySelectorAll<HTMLButtonElement>(`.font-option[data-font-kind="${kind}"]`).forEach(btn => {
            btn.setAttribute('aria-pressed', String(btn.dataset.fontId === id));
          });
          if (persist) {
            try { localStorage.setItem(FONT_STORAGE_KEYS[kind], id); } catch {}
          }
        }
        document.addEventListener('portfolio:font', event => {
          const { kind, id, persist } = (event as CustomEvent<{ kind: FontKind; id: string; persist: boolean }>).detail;
          if (isFontKind(kind)) applyFont(kind, id, persist);
        });
        (['en', 'jp'] as const).forEach(kind => {
          let stored: string | null = null;
          try { stored = localStorage.getItem(FONT_STORAGE_KEYS[kind]); } catch {}
          if (stored && isFontId(kind, stored)) applyFont(kind, stored);
        });
        // 設定パネルのボタンは本文より前に描画済みなので、ここで選択状態を同期する
        (['en', 'jp'] as const).forEach(kind => applyFont(kind, root.dataset[kind === 'en' ? 'fontEn' : 'fontJp'] || FONT_OPTIONS[kind].default));

        document.addEventListener('DOMContentLoaded', function () {
          const toggleBtn = document.getElementById('settings-toggle');
          const panel     = document.getElementById('settings-panel');
          const slider    = document.getElementById('hue-slider') as HTMLInputElement | null;

          // パネル開閉
          toggleBtn?.addEventListener('click', () => {
            if (root.dataset.displayMode === 'gba') {
              panel?.classList.remove('open');
              toggleBtn.classList.remove('active');
              document.dispatchEvent(new CustomEvent('gb:open-options'));
              return;
            }
            panel?.classList.toggle('open');
            toggleBtn.classList.toggle('active');
            // 見本表示のため、開いたときに全候補の @font-face を登録（実際に読むのはラベルの文字分だけ）
            if (panel?.classList.contains('open')) {
              (['en', 'jp'] as const).forEach(kind => FONT_OPTIONS[kind].options.forEach(opt => ensureFontCss(kind, opt.id)));
            }
          });

          // パネル外クリックで閉じる
          document.addEventListener('click', (e) => {
            const target = e.target as Node | null;
            if (!panel?.contains(target) && target !== toggleBtn) {
              panel?.classList.remove('open');
              toggleBtn?.classList.remove('active');
            }
          });

          // スライダー操作
          slider?.addEventListener('input', () => {
            const hue = Number(slider.value);
            applyHue(hue);
            localStorage.setItem(HUE_KEY, String(hue));
          });

          // フォントボタン
          document.querySelectorAll<HTMLButtonElement>('.font-option').forEach(btn => {
            btn.addEventListener('click', () => {
              const kind = btn.dataset.fontKind;
              if (isFontKind(kind) && btn.dataset.fontId) applyFont(kind, btn.dataset.fontId, true);
            });
          });

          // プリセットボタン
          document.querySelectorAll('.hue-preset-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              const hue = Number((btn as HTMLElement).dataset.hue);
              applyHue(hue);
              localStorage.setItem(HUE_KEY, String(hue));
            });
          });
        });
      })();
    </script>
  </body>
</html>
